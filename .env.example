# Only needed for the /admin paste-and-publish page. Reviews written with Claude Code
# and pushed directly need none of this.

# Pick something long. This is the only thing standing between the internet and your repo.
ADMIN_PASSWORD=

# Fine-grained GitHub personal access token, scoped to this repository only,
# with Repository permissions -> Contents: Read and write.
GITHUB_TOKEN=
GITHUB_REPO=Siebe-wq/PAIS-review
GITHUB_BRANCH=main

# Public, optional.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
